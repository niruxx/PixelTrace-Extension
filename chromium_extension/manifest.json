{
  "manifest_version": 3,
  "name": "PixelSearch",
  "version": "1.0.0",
  "description": "Right-click any image to reverse image search it on Google, Bing, Yandex, TinEye, and more.",
  "minimum_chrome_version": "99",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "storage", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "PixelSearch settings"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
