{
  "manifest_version": 3,
  "name": "Reverse Image Search",
  "version": "1.0.0",
  "description": "Right-click any image to reverse image search it on Google, Bing, Yandex, TinEye, and more.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "storage", "notifications"],
  "background": {
    "scripts": ["engines.js", "background.js"]
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Reverse Image Search settings"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "reverse-image-search@searchimage.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
